# PostgreSQL local development settings
POSTGRES_DB=computer_store
POSTGRES_USER=computer_store
POSTGRES_PASSWORD=computer_store
POSTGRES_PORT=5432

# Backend local development settings
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/computer_store
SPRING_DATASOURCE_USERNAME=computer_store
SPRING_DATASOURCE_PASSWORD=computer_store
CORS_ALLOWED_ORIGIN=http://localhost:4200

# Replace this value before using any environment beyond local development.
JWT_SECRET=local-development-secret-change-before-production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
