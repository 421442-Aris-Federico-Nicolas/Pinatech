# External PostgreSQL datasource. Do not store real credentials in this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Storefront production settings
FRONTEND_PORT=80
BACKEND_PORT=8080
CORS_ALLOWED_ORIGIN=https://store.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=

# At least 32 random bytes, preferably generated with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
AUTH_MAX_REGISTRATION_ATTEMPTS=3
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_MAX_REFRESH_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Orders
ORDER_RESERVATION_TTL=PT15M
ORDER_EXPIRATION_BATCH_SIZE=100
ORDER_EXPIRATION_CHECK_INTERVAL_MS=60000

# Used when running the backend outside Docker.
FILE_STORAGE_ROOT=./uploads

# Mercado Pago Checkout Pro (disabled by default).
MP_ENABLED=false
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
PUBLIC_BASE_URL=https://store.example.com
MP_CONNECT_TIMEOUT=PT3S
MP_READ_TIMEOUT=PT10S
MP_PRODUCTION_CONFIRMATION=false
MP_WEBHOOK_TIMESTAMP_TOLERANCE=PT5M
# Payment discovery stops this long after a preference expires; refunds keep their own retry queue.
MP_RECONCILIATION_LOOKBACK=PT720H
MP_REFUND_RECONCILIATION_INTERVAL_MS=60000
