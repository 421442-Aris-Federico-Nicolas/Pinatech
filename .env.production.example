# Copy this template outside the repository (for example to
# /etc/pinatech/production.env), fill it there, and set owner root/mode 0600.

# Public endpoint and ACME account. APP_DOMAIN must not include a scheme or path.
# Production Compose derives CORS and both Mercado Pago public URLs from APP_DOMAIN.
APP_DOMAIN=store.example.com
ACME_EMAIL=ops@example.com

# Compose joins each registry repository and digest as IMAGE@sha256:IMAGE_DIGEST.
# Digests are intentionally blank: resolve and verify the exact release before deployment.
# Runtime UIDs assume the repo Dockerfiles, Caddy 2.10.2-alpine and PostgreSQL 17.10-alpine.
CADDY_IMAGE=docker.io/library/caddy
CADDY_IMAGE_DIGEST=
FRONTEND_IMAGE=registry.example.com/pinatech/frontend
FRONTEND_IMAGE_DIGEST=
BACKEND_IMAGE=registry.example.com/pinatech/backend
BACKEND_IMAGE_DIGEST=
# External PostgreSQL datasource. Keep the password in the private production file only.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT. Use at least 32 random bytes and keep this value out of the repository.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# In-process abuse controls. Add an external rate limiter/WAF for public traffic.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_MAX_REGISTRATION_ATTEMPTS=3
AUTH_MAX_REFRESH_ATTEMPTS=20
AUTH_MAX_ACCOUNT_ACTION_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Account actions and transactional email.
EMAIL_VERIFICATION_TTL=PT24H
PASSWORD_RESET_TTL=PT1H
EMAIL_CHANGE_TTL=PT1H
EMAIL_LOGO_URL=https://store.example.com/pinatech-favicon.png
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=Store <cuentas@store.example.com>
SELLER_NOTIFICATION_EMAIL=ventas@store.example.com
EMAIL_OUTBOX_INTERVAL_MS=10000

# Order reservations.
ORDER_RESERVATION_TTL=PT15M
ORDER_EXPIRATION_BATCH_SIZE=100
ORDER_EXPIRATION_CHECK_INTERVAL_MS=60000

# Cordoba pickup point. PICKUP_ADDRESS_LINES is a comma-separated list.
# Enable only after every public field has been reviewed.
PICKUP_ENABLED=false
PICKUP_LOCATION_CODE=
PICKUP_LOCATION_NAME=
PICKUP_ADDRESS_LINES=
PICKUP_LOCALITY=
PICKUP_PROVINCE_CODE=
PICKUP_POSTAL_CODE=
PICKUP_INSTRUCTIONS=
PICKUP_HOURS=

# Zipnova uses production credentials. Activate only after the controlled verification checklist.
ZIPNOVA_ENABLED=false
ZIPNOVA_PRODUCTION_CONFIRMATION=false
ZIPNOVA_TOKEN=
ZIPNOVA_SECRET=
ZIPNOVA_ACCOUNT_ID=
ZIPNOVA_ORIGIN_ID=
ZIPNOVA_SOURCE=pinatech-prod
ZIPNOVA_PACKAGING_MODE=dynamic
ZIPNOVA_QUOTE_TTL=PT15M
ZIPNOVA_CONNECT_TIMEOUT=PT3S
ZIPNOVA_READ_TIMEOUT=PT15S
# URL-safe random value (A-Z, a-z, 0-9, _ or -), 24-200 characters.
ZIPNOVA_WEBHOOK_SECRET=
ZIPNOVA_RECONCILIATION_INTERVAL=PT10M

# Bank transfer remains disabled until the account, private volume and review process are verified.
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_TAX_ID=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_CBU=
BANK_TRANSFER_CURRENCY=ARS
BANK_TRANSFER_PROOF_TTL=PT24H
BANK_TRANSFER_RETENTION_INTERVAL_MS=3600000
BANK_TRANSFER_ORPHAN_INTERVAL_MS=86400000
PRIVATE_DOCUMENTS_SUBROOT=bank-transfer-proofs

# Mercado Pago remains disabled until the production release gates are complete.
# Set MP_PRODUCTION_CONFIRMATION=true only together with reviewed production credentials.
MP_ENABLED=false
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_STOREFRONT_BASE_URL=https://store.example.com
MP_WEBHOOK_BASE_URL=https://api.example.com
MP_CONNECT_TIMEOUT=PT3S
MP_READ_TIMEOUT=PT10S
MP_PRODUCTION_CONFIRMATION=false
MP_WEBHOOK_TIMESTAMP_TOLERANCE=PT5M
# Payment discovery stops this long after a preference expires; refunds keep their own retry queue.
MP_RECONCILIATION_LOOKBACK=PT720H
MP_REFUND_RECONCILIATION_INTERVAL_MS=60000
