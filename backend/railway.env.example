# Railway injects PORT automatically. Do not define it manually.
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://SUPABASE_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGIN=https://pinatech.com.ar
REFRESH_COOKIE_SECURE=true

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_MAX_REGISTRATION_ATTEMPTS=3
AUTH_MAX_REFRESH_ATTEMPTS=20
AUTH_MAX_ACCOUNT_ACTION_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

EMAIL_VERIFICATION_TTL=PT24H
PASSWORD_RESET_TTL=PT1H
EMAIL_CHANGE_TTL=PT1H
STOREFRONT_BASE_URL=https://pinatech.com.ar
EMAIL_LOGO_URL=https://pinatech.com.ar/pinatech-favicon.png
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=Pinatech <cuentas@pinatech.com.ar>
EMAIL_OUTBOX_INTERVAL_MS=10000

ORDER_RESERVATION_TTL=PT15M
ORDER_EXPIRATION_BATCH_SIZE=100
ORDER_EXPIRATION_CHECK_INTERVAL_MS=60000
PICKUP_ENABLED=false
PICKUP_LOCATION_CODE=
PICKUP_LOCATION_NAME=
PICKUP_ADDRESS_LINES=
PICKUP_LOCALITY=
PICKUP_PROVINCE_CODE=
PICKUP_POSTAL_CODE=
PICKUP_INSTRUCTIONS=
PICKUP_HOURS=

FILE_STORAGE_ROOT=/app/uploads
PRIVATE_DOCUMENTS_SUBROOT=bank-transfer-proofs

BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_TAX_ID=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_CBU=
BANK_TRANSFER_CURRENCY=ARS
BANK_TRANSFER_PROOF_TTL=PT24H
BANK_TRANSFER_RETENTION_INTERVAL_MS=3600000
BANK_TRANSFER_ORPHAN_INTERVAL_MS=86400000

MP_STOREFRONT_BASE_URL=https://pinatech.com.ar
MP_WEBHOOK_BASE_URL=https://api.pinatech.com.ar

MP_ENABLED=false
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_CONNECT_TIMEOUT=PT3S
MP_READ_TIMEOUT=PT10S
MP_PRODUCTION_CONFIRMATION=false
MP_WEBHOOK_TIMESTAMP_TOLERANCE=PT5M
MP_RECONCILIATION_LOOKBACK=PT720H
MP_REFUND_RECONCILIATION_INTERVAL_MS=60000

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
