{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/write-deployment-version.mjs",
    "build:vercel": "ng build --configuration production,vercel && node scripts/write-deployment-version.mjs",
    "test:deployment-version-script": "node --test scripts/write-deployment-version.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "21.2.20",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.20",
    "@angular/compiler": "21.2.20",
    "@angular/core": "21.2.20",
    "@angular/forms": "21.2.20",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.20",
    "@angular/router": "21.2.20",
    "iconify-icon": "^3.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.20",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.8"
  }
}
